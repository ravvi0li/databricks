{
  "datasets": [
    {
      "name": "7609c425",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\n",
        "longitude,\n",
        "`GHG emissions mtons CO2e` as Emissions \n",
        "FROM emmisions.default.emissions_data"
      ]
    },
    {
      "name": "18a7d8cb",
      "displayName": "Emissions per Person",
      "queryLines": [
        "SELECT county_state_name,\n",
        "population,\n",
        "CAST(\n",
        "    REPLACE(`GHG emissions mtons CO2e`, ',','')\n",
        "    AS double\n",
        ") / NULLIF(\n",
        "    CAST(\n",
        "        REPLACE(population, ',','')\n",
        "        as double\n",
        "    ), 0\n",
        ") as Emissions_per_person\n",
        "FROM emmisions.default.emissions_data\n",
        "ORDER BY Emissions_per_person DESC\n"
      ]
    },
    {
      "name": "9f6bd45f",
      "displayName": "Total Emissions per State",
      "queryLines": [
        "SELECT state_abbr,\n",
        "SUM(\n",
        "    CAST(\n",
        "        REPLACE(`GHG emissions mtons CO2e`, ',','')\n",
        "        AS double\n",
        "    )) as Total_emissions\n",
        "FROM emissions_data\n",
        "Group by state_abbr\n",
        "ORDER BY total_emissions DESC\n",
        "limit 10"
      ],
      "catalog": "emmisions",
      "schema": "default"
    },
    {
      "name": "ae9fc03f",
      "displayName": "county shamin",
      "queryLines": [
        "SELECT county_state_name,\n",
        "population,\n",
        "CAST(\n",
        "    REPLACE(`GHG emissions mtons CO2e`, ',', '')\n",
        "    AS DOUBLE) AS total_Emissions\n",
        "FROM emissions_data\n",
        "ORDER BY total_emissions DESC\n",
        "LIMIT 10"
      ],
      "catalog": "emmisions",
      "schema": "default"
    }
  ],
